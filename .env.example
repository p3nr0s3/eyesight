# Database (omit locally to use embedded PGlite; set for PostgreSQL on Vercel / Render)
# DATABASE_URL=postgresql://user:password@host:5432/eyesight?sslmode=require

# Security & Auth (login portal is required by default; set to "false" to disable)
# ENCRYPTION_SECRET=replace-with-32-byte-hex-or-random-passphrase
# AUTH_REQUIRED=true

# Optional Server-Side Threat Intel API Keys (zero-key providers work without these)
# VT_API_KEY=
# ABUSEIPDB_API_KEY=
# OTX_API_KEY=
# SHODAN_API_KEY=
# GREYNOISE_API_KEY=
# ABUSECH_AUTH_KEY=
